<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory>
        <Preference
            android:title="@string/xcap_setting_title"
            android:key="button_xcap_setting"
            android:summary="@string/xcap_setting_summary">
            <intent
                android:targetPackage="jp.softbank.mb.xcap"
                android:action="android.intent.action.MAIN"
                android:targetClass="jp.softbank.mb.xcap.XcapMainActivity"/>
        </Preference>
        <Preference
            android:title="@string/phone_account_settings"
            android:key="button_phone_account">
            <intent
                android:targetPackage="com.android.phone"
                android:action="android.intent.action.MAIN"
                android:targetClass="com.android.phone.settings.PhoneAccountSettingsActivity"/>
        </Preference>
        <Preference
            android:title="@string/network_settings_title"
            android:key="pref_key_call_network_setting">
            <intent
                android:targetPackage="com.android.phone"
                android:action="android.intent.action.MAIN"
                android:targetClass="com.android.phone.settings.MobileNetworkSettings"/>
        </Preference>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/filp_auto_answer_call_title"
            android:key="button_filp_auto_answer_call_key"/>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/filp_auto_hangup_call_title"
            android:key="button_filp_auto_hangup_call_key"
            android:summary="@string/filp_auto_hangup_call_summary"/>
        <Preference
            android:title="@string/voip_setting"
            android:key="pref_key_voip_setting">
            <intent
                android:targetPackage="com.miui.voip"
                android:action="android.intent.action.MAIN"
                android:targetClass="com.miui.voiptalk.preference.VoipPreferenceActivity"/>
        </Preference>
        <com.android.phone.custompreferences.MiuixTextPreference
            android:title="@string/call_record_setting"
            android:key="pref_key_call_record_setting">
            <intent
                android:targetPackage="com.android.phone"
                android:action="android.intent.action.MAIN"
                android:targetClass="com.android.phone.settings.CallRecordSetting"/>
        </com.android.phone.custompreferences.MiuixTextPreference>
        <Preference
            android:persistent="false"
            android:title="@string/call_forwarding_settings"
            android:key="button_call_forwarding">
            <intent
                android:targetPackage="com.android.phone"
                android:action="android.intent.action.MAIN"
                android:targetClass="com.android.phone.settings.CallForwardActivity"/>
        </Preference>
        <Preference
            android:persistent="false"
            android:title="@string/voicemail_callforward_settings"
            android:key="button_voicemail_callforward"/>
        <Preference
            android:persistent="false"
            android:title="@string/call_waiting_title"
            android:key="button_call_waiting"
            android:summary="@string/call_waiting_summary">
            <intent
                android:targetPackage="com.android.phone"
                android:action="android.intent.action.MAIN"
                android:targetClass="com.android.phone.settings.CallWaitingActivity"/>
        </Preference>
        <Preference
            android:title="@string/answer_state_setting_title"
            android:key="button_answer_state_setting"
            android:summary="@string/answer_state_setting_summary">
            <intent
                android:targetPackage="com.android.phone"
                android:action="android.intent.action.MAIN"
                android:targetClass="com.android.phone.settings.AnswerStateSetting"/>
        </Preference>
        <Preference
            android:title="@string/ai_assistant_setting_title"
            android:key="button_ai_assistant_setting">
            <intent
                android:targetPackage="com.xiaomi.aiasst.service"
                android:action="com.xiaomi.aiasst.service.aicall.settings">
                <extra
                    android:name="from_package"
                    android:value="com.android.incallui"/>
            </intent>
        </Preference>
        <com.android.phone.custompreferences.MiuixTextPreference
            android:title="@string/cloud_antispam_title"
            android:key="pref_key_cloud_antispam">
            <intent
                android:targetPackage="com.miui.yellowpage"
                android:action="miui.intent.action.TURN_ON_SMART_ANTISPAM"/>
        </com.android.phone.custompreferences.MiuixTextPreference>
        <com.android.phone.custompreferences.MiuixTextPreference
            android:title="@string/antispam_setting"
            android:key="pref_key_antispam_setting">
            <intent
                android:targetPackage="com.miui.securitycenter"
                android:action="com.miui.antispam.action.ANTISPAM_SETTINGS"
                android:targetClass="com.miui.antispam.ui.activity.AntiSpamNewSettingsActivity"/>
        </com.android.phone.custompreferences.MiuixTextPreference>
        <Preference
            android:title="@string/preference_telocation_title"
            android:key="pref_key_telocation">
            <intent
                android:targetPackage="com.android.phone"
                android:action="android.intent.action.MAIN"
                android:targetClass="com.android.phone.settings.TelocationSetting"/>
        </Preference>
        <com.android.phone.custompreferences.MiuixTextPreference
            android:title="@string/auto_answer_pref_title"
            android:key="button_auto_answer_screen">
            <intent
                android:targetPackage="com.android.phone"
                android:action="android.intent.action.MAIN"
                android:targetClass="com.android.phone.settings.AutoAnswerSetting"/>
        </com.android.phone.custompreferences.MiuixTextPreference>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/sensor_answer_title"
            android:key="perf_sensor_answer"
            android:summary="@string/sensor_answer_summary"
            android:defaultValue="false"/>
        <miuix.preference.DropDownPreference
            android:title="@string/phone_report_title"
            android:key="button_incoming_call_report"
            android:defaultValue="2"
            app:entries="@array/report_method_entries"
            app:entryValues="@array/report_method_entry_values"/>
        <Preference
            android:title="@string/call_fold_setting_title"
            android:key="call_fold_setting"/>
        <Preference
            android:title="@string/newcall_settings_title"
            android:key="button_newcall"
            android:summary="@string/newcall_settings_summary">
            <intent
                android:targetPackage="com.newcall"
                android:action="android.intent.action.MAIN"
                android:targetClass="com.newcall.setting.SettingsActivity"/>
        </Preference>
        <Preference
            android:title="@string/call_advanced_setting_title"
            android:key="call_advanced_setting"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="">
        <com.android.phone.custompreferences.MiuixTextPreference
            android:title="@string/privacy_setting"
            android:key="pref_key_privacy_policy"/>
        <Preference
            android:title="@string/feedback_title"
            android:key="pref_key_feedback"/>
    </PreferenceCategory>
</PreferenceScreen>
