<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:phone="http://schemas.android.com/apk/res/com.android.phone" android:title="@string/switch_debug_menu">
    <PreferenceCategory
        android:title="@string/general_settings_category"
        android:key="general_class">
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/show_volte_switch_title"
            android:key="volte_switch"
            android:summary="@string/show_volte_switch_summary"/>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/show_vonr_switch_title"
            android:key="vonr_switch"
            android:summary="@string/show_vonr_switch_summary"/>
        <com.android.phone.custompreferences.MiuixTextPreference
            android:persistent="false"
            android:title="@string/fiveg_nrca_switch_title"
            android:key="nrca_switch"
            android:summary="@string/fiveg_nrca_switch_summary">
            <intent
                android:targetPackage="com.android.phone"
                android:targetClass="com.android.phone.FiveGNrcaSettingActivity"/>
        </com.android.phone.custompreferences.MiuixTextPreference>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/show_vowifi_switch_title"
            android:key="vowifi_switch"
            android:summary="@string/show_vowifi_switch_summary"/>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/fiveg_sa_vice_switch_title"
            android:key="voice_sa_switch"
            android:summary="@string/fiveg_sa_vice_switch_summary"/>
        <com.android.phone.custompreferences.MiuixTextPreference
            android:persistent="false"
            android:title="@string/sa_switch_debug_title"
            android:key="show_sa_switch"
            android:summary="@string/sa_switch_debug_summary"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/optimization_settings_category"
        android:key="optimization_calss">
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/fiveg_power_switch_title"
            android:key="fiveg_power_switch"
            android:summary="@string/fiveg_power_switch_summary"/>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/n28_title"
            android:key="n28_switch"
            android:summary="@string/n28_summary"/>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/dsda_title"
            android:key="dsda_switch"
            android:summary="@string/dsda_summary"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/other_settings_categorys"
        android:key="other_calss">
        <com.android.phone.custompreferences.MiuixTextPreference
            android:exported="false"
            android:title="@string/fiveg_info"
            android:key="fiveg_info">
            <intent
                android:targetPackage="com.android.phone"
                android:action="android.intent.action.MAIN"
                android:targetClass="com.android.phone.NRDisplayActivity"/>
        </com.android.phone.custompreferences.MiuixTextPreference>
        <com.android.phone.custompreferences.MiuixTextPreference
            android:persistent="false"
            android:title="@string/opconfig_info"
            android:key="opconfig"/>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/uplmn_title"
            android:key="uplmn_switch"
            android:summary="@string/uplmn_summary"/>
    </PreferenceCategory>
</PreferenceScreen>
