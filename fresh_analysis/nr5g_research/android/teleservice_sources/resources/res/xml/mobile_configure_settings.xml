<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:settings="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:title="@string/advanced_mobile_settings">
    <PreferenceCategory
        android:title="@string/mobile_intelligent_connection_title"
        android:key="mobile_intelligent_connection">
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:title="@string/mobile_special_network_optimization_config_title"
            android:key="mobile_special_network_optimization_config_enabled_key"
            android:summary="@string/mobile_special_network_optimization_config_summary"/>
        <Preference
            android:title="@string/mobile_geo_location_config_title"
            android:key="mobile_geo_location_config_key"
            android:summary="@string/mobile_geo_location_config_summary">
            <intent
                android:targetPackage="com.miui.geolocation"
                android:targetClass="com.miui.geolocation.ui.settings.SwipingCardLocationListActivity"/>
        </Preference>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/traffic_mode_switch_title"
            android:key="button_traffic_mode_enabled_key"
            android:summary="@string/traffic_mode_summary"/>
        <Preference
            android:persistent="false"
            android:title="@string/smart_multinetwork_acceleration_title"
            android:key="button_smart_multinetwork_acceleration_key">
            <intent
                android:targetPackage="com.android.settings"
                android:targetClass="com.android.settings.wifi.linkturbo.WifiLinkTurboSettings"/>
        </Preference>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/mobile_network_dual_card_optimizationmobile_title"
        android:key="mobile_network_dual_card_optimizationmobile">
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/smart_dual_sim_title"
            android:key="button_smart_dual_sim_key"
            android:summary="@string/smart_dual_sim_summary"/>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/vice_slot_volte_data_switch_title"
            android:key="button_vice_slot_volte_data"
            android:summary="@string/vice_slot_volte_data_switch_summary"/>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/smart_switch_dual_sim_title"
            android:key="button_smart_switch_dual_sim_key"
            android:summary="@string/smart_switch_dual_sim_summary"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/mobile_connection_management"
        android:key="mobile_connection_manage">
        <com.android.phone.settings.RestrictedPreference
            android:title="@string/international_roaming_setting"
            android:key="button_roaming_key"
            android:summary="@string/roaming_disable">
            <intent
                android:targetPackage="com.miui.securitycenter"
                android:targetClass="com.miui.networkassistant.ui.activity.InternationalRoamingSettingActivity"/>
        </com.android.phone.settings.RestrictedPreference>
        <Preference
            android:persistent="false"
            android:title="@string/netcheck_title"
            android:key="mobile_network_check"
            android:summary="@string/main_netcheck_summary">
            <intent
                android:targetPackage="com.miui.securitycenter"
                android:targetClass="com.miui.networkassistant.ui.activity.NetworkDiagnosticsActivity"/>
        </Preference>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/mobile_property"
        android:key="mobile_property">
        <Preference
            android:enabled="false"
            android:title="@string/mobile_advanced_nr_network_title"
            android:key="mobile_nr_type"/>
        <Preference
            android:enabled="false"
            android:title="@string/mobile_advanced_ip_address_title"
            android:key="mobile_ip_address"/>
        <Preference
            android:enabled="false"
            android:title="@string/mobile_advanced_dns_server_title"
            android:key="mobile_dns_server"/>
        <miuix.preference.DropDownPreference
            android:title="@string/network_state_display_title"
            android:key="network_state_display"
            app:entries="@array/network_state_display"
            app:entryValues="@array/network_state_display_values"/>
    </PreferenceCategory>
</PreferenceScreen>
