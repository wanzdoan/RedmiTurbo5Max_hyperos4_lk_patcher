<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:settings="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:title="@string/uplmn_list_setting_title">
    <Preference
        android:title="@string/network_id"
        android:key="network_id_key"
        style="@style/Widget.EditText.Dialog"/>
    <EditTextPreference
        android:singleLine="true"
        android:title="@string/dialog_network_priority_title"
        android:key="priority_key"
        android:dialogTitle="@string/dialog_network_priority_title"
        android:inputType="number"
        style="@style/Widget.EditText.Dialog"/>
    <miuix.preference.DropDownPreference
        android:title="@string/gsm_umts_network_preferences_title"
        android:key="network_mode_key"
        app:entries="@array/uplmn_prefer_network_mode_td_choices"
        app:entryValues="@array/uplmn_prefer_network_mode_values"/>
</PreferenceScreen>
