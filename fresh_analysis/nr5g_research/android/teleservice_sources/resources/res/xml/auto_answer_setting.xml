<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:title="@string/auto_answer_setting_title">
    <PreferenceCategory>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/auto_answer_pref_title"
            android:key="button_auto_answer"
            android:summary="@string/auto_answer_pref_summary"
            android:defaultValue="false"/>
        <miuix.preference.DropDownPreference
            android:persistent="false"
            android:title="@string/auto_answer_delay_title"
            android:key="button_auto_answer_delay"
            android:defaultValue="3"
            app:entries="@array/auto_answer_delay_entries"
            app:entryValues="@array/auto_answer_delay_entry_values"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/auto_answer_scenario_title">
        <miuix.preference.SingleChoicePreferenceCategory android:key="button_auto_answer_scenario"/>
    </PreferenceCategory>
</PreferenceScreen>
