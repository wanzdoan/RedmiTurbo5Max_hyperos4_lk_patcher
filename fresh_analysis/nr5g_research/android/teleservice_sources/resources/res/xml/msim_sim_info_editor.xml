<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:settings="http://schemas.android.com/apk/res/com.android.settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/msim_setting_categery_title"
    android:key="sim_info_editor">
    <com.android.phone.custompreferences.CustomCheckBoxPreference
        android:persistent="false"
        android:title="@string/msim_enable_sim"
        android:key="enable_sim"/>
    <PreferenceScreen
        android:persistent="false"
        android:title="@string/go_to_virtual_sim_title"
        android:key="button_go_to_virtual_sim_key"/>
    <PreferenceCategory
        android:title="@string/msim_setting_sim_info_editor_title"
        android:key="sim_name_number_category_key">
        <com.android.phone.custompreferences.CustomEditTextPreference
            android:persistent="false"
            android:singleLine="true"
            android:maxLength="20"
            android:title="@string/msim_info_editor_name"
            android:key="sim_name"
            android:dialogTitle="@string/msim_info_editor_name"
            android:imeOptions="actionDone"
            style="@style/Widget.EditText.Dialog"/>
        <com.android.phone.settings.LTREditTextPreference
            android:persistent="false"
            android:singleLine="true"
            android:maxLength="20"
            android:phoneNumber="true"
            android:title="@string/msim_info_editor_number"
            android:key="sim_number"
            android:dialogTitle="@string/msim_info_editor_number"
            style="@style/Widget.EditText.Dialog"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/msim_setting_operator_network_title"
        android:key="msim_mobile_network_setting">
        <Preference
            android:persistent="false"
            android:title="@string/uplmn_list_setting_title"
            android:key="button_uplmn_key">
            <intent
                android:targetPackage="com.android.phone"
                android:action="android.intent.action.MAIN"
                android:targetClass="com.android.phone.settings.UserPLMNListPreference"/>
        </Preference>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/fiveg_sa_switch_title"
            android:key="button_5g_sa_network_key"/>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/fiveg_sa_vice_switch_title"
            android:key="button_vice_sim_5g_sa_network"
            android:summary="@string/fiveg_sa_switch_summary"/>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/fiveg_carrier_aggregation_title"
            android:key="button_5G_carrier_aggregation"
            android:defaultValue="true"/>
        <Preference
            android:persistent="false"
            android:title="@string/enter_esim_manager_title"
            android:key="button_go_to_esim_manager">
            <intent
                android:targetPackage="com.google.android.euicc"
                android:action="android.telephony.euicc.action.MANAGE_EMBEDDED_SUBSCRIPTIONS"/>
        </Preference>
        <Preference
            android:title="@string/stk_name"
            android:key="button_stk_key">
            <intent
                android:targetPackage="com.android.stk"
                android:action="android.intent.action.MAIN"
                android:targetClass="com.android.stk.StkMain"/>
        </Preference>
        <Preference
            android:title="@string/hide_stk_name"
            android:key="button_hide_stk_key">
            <intent
                android:targetPackage="com.android.stk"
                android:action="miui.intent.action.StkMainHide"
                android:targetClass="com.android.stk.StkMainHide"/>
        </Preference>
        <com.android.phone.settings.CdmaSystemSelectListPreference
            android:entries="@array/cdma_system_select_choices"
            android:title="@string/cdma_system_select_title"
            android:key="cdma_system_select_key"
            android:summary="@string/cdma_system_select_summary"
            android:dialogTitle="@string/cdma_system_select_dialogtitle"
            android:entryValues="@array/cdma_system_select_values"/>
        <Preference
            android:persistent="false"
            android:title="@string/apn_settings"
            android:key="button_apn_key">
            <intent
                android:targetPackage="com.android.settings"
                android:action="android.settings.APN_SETTINGS"/>
        </Preference>
        <Preference
            android:persistent="false"
            android:title="@string/preferred_network_type_title"
            android:key="button_preferred_network_type_key">
            <intent
                android:targetPackage="com.android.phone"
                android:action="android.intent.action.MAIN"
                android:targetClass="com.android.phone.settings.PreferredNetworkTypeListPreference"/>
        </Preference>
        <Preference
            android:persistent="false"
            android:title="@string/networks_title"
            android:key="button_carrier_sel_key">
            <intent
                android:targetPackage="com.android.phone"
                android:action="android.intent.action.MAIN"
                android:targetClass="com.android.phone.settings.NetworkSetting"/>
        </Preference>
        <Preference
            android:persistent="false"
            android:title="@string/convert_to_esim_title"
            android:key="button_convert_to_esim">
            <intent
                android:targetPackage="com.google.android.euicc"
                android:action="android.telephony.euicc.action.CONVERT_TO_EMBEDDED_SUBSCRIPTION"/>
        </Preference>
        <Preference
            android:persistent="false"
            android:title="@string/satellite_setting_title"
            android:key="telephony_satellite_setting_key"
            android:summary="@string/satellite_setting_disabled_summary">
            <intent
                android:targetPackage="com.android.settings"
                android:action="android.settings.SATELLITE_SETTING"
                android:targetClass="com.android.settings.Settings$SatelliteSettingActivity"/>
        </Preference>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/enable_2g_title"
            android:key="enable_2g"
            android:summary="@string/enable_2g_summary"/>
    </PreferenceCategory>
</PreferenceScreen>
