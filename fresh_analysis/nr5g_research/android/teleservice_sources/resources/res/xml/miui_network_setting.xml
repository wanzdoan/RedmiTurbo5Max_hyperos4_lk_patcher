<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:phone="http://schemas.android.com/apk/res/com.android.phone" xmlns:app="http://schemas.android.com/apk/res-auto" android:title="@string/mobile_networks">
    <PreferenceCategory
        android:title="@string/msim_setting_categery_title"
        android:key="sim_info"/>
    <PreferenceCategory android:key="sim_voice_data_info"/>
    <PreferenceScreen
        android:title="@string/cdma_lte_data_service"
        android:key="cdma_lte_data_service_key"/>
    <miuix.preference.PreferenceCategory
        android:title="@string/network_settings_title"
        android:key="sim_general"
        app:needDividerLine="false">
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/mobile_settings_screen_title"
            android:key="button_data_enabled_key"
            android:summary="@string/data_enable_summary"/>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/fiveg_hosted_mode_title"
            android:key="button_5g_hosted_mode_key"
            android:summary="@string/fiveg_hosted_mode_summary"/>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/data_enable_always_warn"
            android:key="button_data_warning_key"/>
        <com.android.phone.custompreferences.MiuixTextPreference
            android:persistent="false"
            android:title="@string/fiveg_network_title"
            android:key="preference_5g_network">
            <intent
                android:targetPackage="com.android.phone"
                android:targetClass="com.android.phone.settings.MiuiFiveGNetworkSetting"/>
        </com.android.phone.custompreferences.MiuixTextPreference>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/intelligent_dual_sim_title"
            android:key="button_intelligent_dual_sim_key"
            android:summary="@string/intelligent_dual_sim_summary"/>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/smart_dual_sim_title"
            android:key="button_smart_dual_sim_key"
            android:summary="@string/smart_dual_sim_summary"/>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/vice_slot_volte_data_switch_title"
            android:key="button_vice_slot_volte_data"
            android:summary="@string/vice_slot_volte_data_switch_summary"/>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/smart_switch_dual_sim_title"
            android:key="button_smart_switch_dual_sim_key"
            android:summary="@string/smart_switch_dual_sim_summary"/>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/volte_switch_title"
            android:key="enhanced_4g_lte"
            android:summary="@string/volte_switch_summary"/>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/fiveg_sa_switch_title"
            android:key="button_5g_sa_network_key"/>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/dual_4g_switch_title"
            android:key="button_dual_4g"
            android:summary="@string/dual_4g_switch_summary"/>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/always_enable_mms"
            android:key="button_mms_enabled_key"
            android:summary="@string/always_enable_mms_summary"/>
        <com.android.phone.settings.RestrictedPreference
            android:persistent="false"
            android:title="@string/business_hall_settings_title"
            android:key="button_enter_business_hall_key"
            android:summary="@string/business_hall_settings_summary">
            <intent
                android:targetPackage="com.miui.virtualsim"
                android:action="com.miui.businesshall.ACTION_ROUTER"/>
        </com.android.phone.settings.RestrictedPreference>
    </miuix.preference.PreferenceCategory>
    <PreferenceCategory
        android:title="@string/esim_setting_title"
        android:key="esim_setting">
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/enable_esim_title"
            android:key="button_enable_esim_key"
            android:summary="@string/enable_esim_summary"/>
        <com.android.phone.custompreferences.MiuixTextPreference
            android:persistent="false"
            android:title="@string/enter_esim_manager_title"
            android:key="preference_esim_manager"/>
        <com.android.phone.custompreferences.MiuixTextPreference
            android:persistent="false"
            android:title="@string/enter_esim_service_support_title"
            android:key="preference_esim_service_support"
            android:summary="@string/enter_esim_service_support_summary"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/wifi_call_setting"
        android:key="wifi_call">
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/wificall_switch_title"
            android:key="enable_wificall"
            android:summary="@string/wificall_switch_summary"/>
        <com.android.phone.custompreferences.MiuixTextPreference
            android:persistent="false"
            android:title="@string/preferred_wificall_title"
            android:key="preferred_wificall_key"/>
        <com.android.phone.custompreferences.MiuixTextPreference
            android:persistent="false"
            android:title="@string/roaming_preferred_wificall_title"
            android:key="roaming_preferred_wificall_key"/>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/voice_link_switch_title"
            android:key="enable_voice_link"
            android:summary="@string/voice_link_switch_summary"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/dial_settings_screen_title"
        android:key="sim_default">
        <com.android.phone.settings.MultiSimDropDownPreference
            android:title="@string/sms_messages_title"
            android:key="default_sms_key"
            android:defaultValue="0"/>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/last_sim_callback_title"
            android:key="button_last_sim_callback"
            android:summary="@string/last_sim_callback_summary"/>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/dual_sim_smart_call_forward_title"
            android:key="button_smart_call_forward"
            android:summary="@string/dual_sim_smart_call_forward_summary"
            android:defaultValue="false"/>
    </PreferenceCategory>
    <PreferenceScreen
        android:persistent="false"
        android:title="@string/uplmn_list_setting_title"
        android:key="button_uplmn_key">
        <intent
            android:targetPackage="com.android.phone"
            android:action="android.intent.action.MAIN"
            android:targetClass="com.android.phone.settings.UserPLMNListPreference"/>
    </PreferenceScreen>
    <PreferenceCategory
        android:title="@string/china_mobile_palm_category"
        android:key="china_mobile_palm">
        <PreferenceScreen
            android:title="@string/china_mobile_palm_title"
            android:key="pref_china_mobile_palm">
            <intent android:action="miui.intent.action.YELLOWPAGE_CHINAMOBILE_PALM"/>
        </PreferenceScreen>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/other_settings_screen_title"
        android:key="additional_mobile_settings"
        android:order="100">
        <com.android.phone.settings.RestrictedPreference
            android:title="@string/international_roaming_setting"
            android:key="button_roaming_key"
            android:summary="@string/roaming_disable">
            <intent
                android:targetPackage="com.miui.securitycenter"
                android:targetClass="com.miui.networkassistant.ui.activity.InternationalRoamingSettingActivity"/>
        </com.android.phone.settings.RestrictedPreference>
        <com.android.phone.settings.RestrictedCheckBoxPreference
            android:persistent="false"
            android:title="@string/international_roaming_setting"
            android:key="button_roaming_checkbox_key"
            android:summary="@string/roaming_disable"/>
        <com.android.phone.settings.RestrictedPreference
            android:title="@string/offline_call"
            android:key="button_offlinecall_key"
            android:summary="@string/offline_call_summary">
            <intent
                android:targetPackage="com.xiaomi.bluetooth"
                android:targetClass="com.android.bluetooth.ble.app.call.HyperCallActivity"/>
        </com.android.phone.settings.RestrictedPreference>
    </PreferenceCategory>
</PreferenceScreen>
