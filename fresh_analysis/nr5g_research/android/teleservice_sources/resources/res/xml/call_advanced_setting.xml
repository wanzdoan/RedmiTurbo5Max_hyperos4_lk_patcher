<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory
        android:title="@string/dial_related_setting_catory"
        android:key="pref_catory_key_dial_related_setting">
        <com.android.phone.custompreferences.MiuixTextPreference
            android:title="@string/preference_dial_pad_touch_tone_title"
            android:key="pref_key_dial_pad_touch_tone"/>
        <miuix.preference.DropDownPreference
            android:persistent="true"
            android:title="@string/t9_indexing_method_title"
            android:key="button_t9_index_method_settings"
            app:entries="@array/t9_indexing_method_entries"
            app:entryValues="@array/t9_indexing_method_entry_values"/>
        <Preference
            android:title="@string/quick_dial_setting_title"
            android:key="button_quick_dial">
            <intent
                android:targetPackage="com.android.contacts"
                android:action="android.intent.action.MAIN"
                android:targetClass="com.android.contacts.quickdial.QuickDialSettingActivity"/>
        </Preference>
        <com.android.phone.settings.CheckBoxTitleIconPreference
            android:persistent="false"
            android:title="@string/auto_redial_pref_title"
            android:key="button_auto_redial"
            android:summary="@string/auto_redial_pref_summary"
            android:defaultValue="false"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/answer_features_setting_category">
        <com.android.phone.custompreferences.MiuixTextPreference
            android:title="@string/autoip"
            android:key="pref_key_auto_ip">
            <intent
                android:targetPackage="com.android.phone"
                android:action="android.intent.action.MAIN"
                android:targetClass="com.android.phone.settings.AutoIpSetting"/>
        </com.android.phone.custompreferences.MiuixTextPreference>
        <miuix.preference.DropDownPreference
            android:title="@string/missed_call_notify_times_title"
            android:key="button_missed_call_notify_times"
            android:summary="@string/missed_call_notify_times_summary"
            android:defaultValue="0"
            app:entries="@array/missed_call_notify_times_entries"
            app:entryValues="@array/missed_call_notify_times_entry_values"/>
        <miuix.preference.DropDownPreference
            android:title="@string/connect_disconnect_vibrate_title"
            android:key="button_connect_disconnect_vibrate"
            android:defaultValue="100"/>
        <com.android.phone.settings.CheckBoxTitleIconPreference
            android:persistent="false"
            android:title="@string/cdma_display_precise_call_state_title"
            android:key="button_display_precise_call_state"
            android:summary="@string/cdma_display_precise_call_state_summary"/>
        <com.android.phone.settings.CdmaVoicePrivacyCheckBoxPreference
            android:persistent="false"
            android:title="@string/voice_privacy"
            android:key="button_voice_privacy"
            android:summary="@string/voice_privacy_summary"/>
        <miuix.preference.DropDownPreference
            android:title="@string/call_waiting_tone_title"
            android:key="button_call_waiting_tone"
            android:defaultValue="0"
            app:entries="@array/call_waiting_tone_entries"
            app:entryValues="@array/call_waiting_tone_entry_values"/>
        <com.android.phone.custompreferences.MiuixTextPreference
            android:persistent="false"
            android:title="@string/reject_via_sms"
            android:key="button_respond_via_sms_key">
            <intent
                android:targetPackage="com.android.phone"
                android:action="android.intent.action.MAIN"
                android:targetClass="com.android.phone.settings.RespondViaSmsManager$Settings"/>
        </com.android.phone.custompreferences.MiuixTextPreference>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/rtt_settings_title"
            android:key="button_rtt_call"
            android:summary="@string/rtt_settings_summary"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/other_settings_category">
        <Preference
            android:persistent="false"
            android:title="@string/lable_call_barring"
            android:key="button_call_barring"
            android:summary="@string/call_barring_sum">
            <intent
                android:targetPackage="com.android.phone"
                android:action="android.intent.action.MAIN"
                android:targetClass="com.android.phone.settings.CallBarring"/>
        </Preference>
        <com.android.phone.settings.TitleIconPreference
            android:persistent="false"
            android:title="@string/caller_id_title"
            android:key="button_caller_id"
            android:summary="@string/caller_id_summary">
            <intent
                android:targetPackage="com.android.phone"
                android:action="android.intent.action.MAIN"
                android:targetClass="com.android.phone.settings.GsmUmtsCallerIdSetting"/>
        </com.android.phone.settings.TitleIconPreference>
        <Preference
            android:persistent="false"
            android:title="@string/fdn"
            android:key="button_fdn"
            android:summary="@string/fdn_summary">
            <intent
                android:targetPackage="com.android.phone"
                android:action="android.intent.action.MAIN"
                android:targetClass="com.android.phone.settings.FdnSetting"/>
        </Preference>
        <Preference
            android:title="@string/voicemail_settings"
            android:key="button_voicemail">
            <intent
                android:targetPackage="com.android.phone"
                android:action="android.intent.action.MAIN"
                android:targetClass="com.android.phone.settings.VoicemailSetting"/>
        </Preference>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/auto_retry_mode_title"
            android:key="button_auto_retry"
            android:summary="@string/auto_retry_mode_summary"/>
        <miuix.preference.DropDownPreference
            android:persistent="false"
            android:title="@string/tty_mode_option_title"
            android:key="button_tty_mode"
            android:summary="@string/tty_mode_option_summary"
            app:entries="@array/tty_mode_entries"
            app:entryValues="@array/tty_mode_values"/>
        <com.android.phone.custompreferences.CustomCheckBoxPreference
            android:persistent="false"
            android:title="@string/hac_mode_title"
            android:key="button_hac"
            android:summary="@string/hac_mode_summary"/>
        <miuix.preference.DropDownPreference
            android:title="@string/dtmf_tones_title"
            android:key="button_dtmf_settings"
            android:summary="@string/dtmf_tones_summary"
            app:entries="@array/dtmf_tone_entries"
            app:entryValues="@array/dtmf_tone_values"/>
        <Preference
            android:title="@string/phone_account_settings"
            android:key="button_phone_account">
            <intent
                android:targetPackage="com.android.phone"
                android:action="android.intent.action.MAIN"
                android:targetClass="com.android.phone.settings.MiuiPhoneAccountSettingsActivity"/>
        </Preference>
    </PreferenceCategory>
</PreferenceScreen>
