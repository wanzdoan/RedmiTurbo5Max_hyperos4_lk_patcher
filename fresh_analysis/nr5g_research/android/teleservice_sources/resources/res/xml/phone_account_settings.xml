<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" android:title="@string/phone_accounts">
    <PreferenceCategory
        android:title="@string/phone_accounts_settings_header"
        android:key="phone_accounts_accounts_list_category_key">
        <PreferenceScreen
            android:persistent="false"
            android:title="@string/phone_accounts_all_calling_accounts"
            android:key="phone_accounts_all_calling_accounts"
            android:summary="@string/phone_accounts_all_calling_accounts_summary"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:persistent="false"
        android:title="@string/make_and_receive_calls"
        android:key="make_and_receive_calls_settings_category_key">
        <com.android.phone.settings.AccountSelectionPreference
            android:persistent="false"
            android:title="@string/phone_accounts_make_calls_with"
            android:key="default_outgoing_account"
            android:defaultValue=""/>
        <PreferenceScreen
            android:persistent="false"
            android:title="@string/smart_forwarding_settings_menu"
            android:key="smart_forwarding_configuration_key"
            android:summary="@string/smart_forwarding_settings_menu_summary"/>
        <SwitchPreference
            android:persistent="false"
            android:title="@string/vibrating_for_outgoing_call_accepted_title"
            android:key="button_vibrating_for_outgoing_call_accepted_key"
            android:summary="@string/vibrating_for_outgoing_call_accepted_summary"/>
        <SwitchPreference
            android:persistent="false"
            android:title="@string/playing_tone_for_outgoing_call_accepted_title"
            android:key="button_playing_tone_for_outgoing_call_accepted_key"
            android:summary="@string/playing_tone_for_outgoing_call_accepted_summary"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/voip_call_log_integration_label"
        android:key="voip_call_log_integration_category_key"/>
</PreferenceScreen>
