<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/miuix_popupwidget_popup_anim_container"
    android:background="?attr/colorSurfaceHighest"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minWidth="260dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/miuix_appcompat_action_sheet_pop_content_message_font_size"
        android:textColor="?attr/colorOnSurfaceTertiary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/action_sheet_message"
        android:background="?attr/colorSurfaceHighest"
        android:paddingTop="@dimen/miuix_appcompat_action_sheet_pop_message_padding_top"
        android:paddingBottom="@dimen/miuix_appcompat_action_sheet_pop_message_padding_bottom"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:textDirection="locale"
        android:textAlignment="center"
        android:paddingStart="@dimen/miuix_appcompat_action_sheet_pop_content_message_horizontal_padding"
        android:paddingEnd="@dimen/miuix_appcompat_action_sheet_pop_content_message_horizontal_padding"/>
    <miuix.springback.view.SpringBackLayout
        android:id="@+id/actionSheetSpringBack"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:scrollOrientation="vertical"
        app:scrollableView="@+id/action_sheet_list_view">
        <ListView
            android:textAppearance="@style/ActionSheetPopListItem"
            android:layout_gravity="center"
            android:id="@+id/action_sheet_list_view"
            android:background="?attr/colorSurfaceHighest"
            android:scrollbars="vertical"
            android:fadingEdge="none"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:cacheColorHint="@null"
            android:divider="?android:attr/listDividerAlertDialog"
            android:scrollbarFadeDuration="100"
            android:scrollbarDefaultDelayBeforeFade="100"
            android:overScrollMode="ifContentScrolls"
            android:textAlignment="center"/>
    </miuix.springback.view.SpringBackLayout>
</LinearLayout>
