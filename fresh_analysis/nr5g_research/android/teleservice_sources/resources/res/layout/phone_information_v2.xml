<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/content_container"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/manual_bottom_nav_separator"/>
    <View
        android:id="@+id/manual_bottom_nav_separator"
        android:background="?android:attr/listDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@+id/bottom_nav_scroll_view"/>
    <HorizontalScrollView
        android:id="@+id/bottom_nav_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/manual_bottom_nav_bar"
            android:background="?android:attr/windowBackground"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/nav_item_one_container"
                android:background="?android:attr/selectableItemBackground"
                android:padding="8dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="110dp">
                <ImageView
                    android:id="@+id/nav_item_one_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_sim_card_alt"
                    android:scaleType="fitCenter"/>
                <TextView
                    android:textSize="12sp"
                    android:id="@+id/nav_item_one_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/tab_title_device_details"/>
            </LinearLayout>
            <View
                android:background="?android:attr/listDivider"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/nav_item_two_container"
                android:background="?android:attr/selectableItemBackground"
                android:padding="8dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="110dp">
                <ImageView
                    android:id="@+id/nav_item_two_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_signal_cellular_alt_24px"
                    android:scaleType="fitCenter"/>
                <TextView
                    android:textSize="12sp"
                    android:id="@+id/nav_item_two_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/tab_title_data_network"/>
            </LinearLayout>
            <View
                android:background="?android:attr/listDivider"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/nav_item_three_container"
                android:background="?android:attr/selectableItemBackground"
                android:padding="8dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="110dp">
                <ImageView
                    android:id="@+id/nav_item_three_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_satellite_alt_24px"
                    android:scaleType="fitCenter"/>
                <TextView
                    android:textSize="12sp"
                    android:id="@+id/nav_item_three_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/tab_title_satellite"/>
            </LinearLayout>
            <View
                android:background="?android:attr/listDivider"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/nav_item_four_container"
                android:background="?android:attr/selectableItemBackground"
                android:padding="8dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="110dp">
                <TextView
                    android:textSize="28sp"
                    android:gravity="center"
                    android:id="@+id/nav_item_four_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_title_ims"
                    android:textAlignment="center"/>
            </LinearLayout>
            <View
                android:background="?android:attr/listDivider"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>
        </LinearLayout>
    </HorizontalScrollView>
</RelativeLayout>
