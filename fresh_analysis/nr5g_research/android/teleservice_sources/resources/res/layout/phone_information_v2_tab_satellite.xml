<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/phone_button_0"
            android:background="?android:attr/selectableItemBackground"
            android:padding="12dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textStyle="bold"
                android:id="@+id/phone_button_0_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone0_title"/>
        </LinearLayout>
        <View
            android:background="?android:attr/listDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/phone_button_1"
            android:background="?android:attr/selectableItemBackground"
            android:padding="12dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textStyle="bold"
                android:id="@+id/phone_button_1_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone1_title"/>
        </LinearLayout>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Switch
                android:textSize="14sp"
                android:id="@+id/enforce_satellite_channel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/enforce_satellite_channel_label"/>
            <RadioGroup
                android:orientation="horizontal"
                android:id="@+id/force_camp_satellite_selection_radio_group"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <RadioButton
                    android:id="@+id/starlink_band"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/starlink_satellite_band_string"
                    android:layout_marginEnd="4dp"/>
                <RadioButton
                    android:id="@+id/ast_band"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ast_satellite_band_string"
                    android:layout_marginEnd="4dp"/>
                <RadioButton
                    android:id="@+id/manual_override_band"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/manual_override_satellite_band_string"/>
            </RadioGroup>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/manual_override_fields"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/manual_band_selector_label"
                    android:text="@string/satellite_manual_band_label"
                    style="@style/info_label"/>
                <Spinner
                    android:id="@+id/manual_band_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/satellite_channel_label"
                    android:text="@string/satellite_channel_label_text"
                    style="@style/info_label"/>
                <EditText
                    android:id="@+id/satellite_channel_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/satellite_channel_hint_text"
                    android:inputType="number"
                    android:imeOptions="actionDone"
                    style="@style/form_value"/>
            </LinearLayout>
            <Button
                android:textSize="14sp"
                android:id="@+id/force_camp_satellite_button"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/force_camp_satellite_button_string"
                android:textAllCaps="false"/>
            <Switch
                android:textSize="14sp"
                android:id="@+id/mock_carrier_roaming_satellite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/mock_carrier_roaming_satellite_label"/>
            <Switch
                android:textSize="14sp"
                android:id="@+id/satellite_data_controller_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/choose_satellite_data_mode_label"/>
            <RadioGroup
                android:orientation="horizontal"
                android:id="@+id/satellite_data_controller"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <RadioButton
                    android:id="@+id/satellite_data_restricted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4dp"
                    android:text="@string/satellite_data_restricted_string"/>
                <RadioButton
                    android:id="@+id/satellite_data_constrained"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4dp"
                    android:text="@string/satellite_data_constrained_string"/>
                <RadioButton
                    android:id="@+id/satellite_data_unConstrained"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/satellite_data_unConstrained_string"/>
            </RadioGroup>
            <Button
                android:textSize="14sp"
                android:id="@+id/esos_questionnaire"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/esos_satellite_label"
                android:textAllCaps="false"/>
            <Button
                android:textSize="14sp"
                android:id="@+id/satellite_enable_non_emergency_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/satellite_enable_non_emergency_mode_label"
                android:textAllCaps="false"/>
            <Button
                android:textSize="14sp"
                android:id="@+id/demo_esos_questionnaire"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/demo_esos_satellite_label"
                android:textAllCaps="false"/>
            <Button
                android:textSize="14sp"
                android:id="@+id/nb_iot_config_viewer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/nb_iot_config_viewer"
                android:textAllCaps="false"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
