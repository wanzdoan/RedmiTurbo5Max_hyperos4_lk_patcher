<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/dialpadAdditionalButtons"
    android:layout_width="@dimen/dial_panel_button_line_width"
    android:layout_height="@dimen/dial_additional_button_height"
    android:layout_marginBottom="@dimen/dialpadAdditionalButtons_padding_bottom"
    android:layout_alignParentBottom="true"
    android:layout_centerHorizontal="true">
    <LinearLayout
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/backButton"
            android:layout_width="@dimen/dial_additional_button_height"
            android:layout_height="@dimen/dial_additional_button_height"
            android:src="@drawable/ic_emergency_back"
            android:contentDescription="@string/back"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <miuix.miuixbasewidget.widget.CallOvalImageButton
            android:state_enabled="false"
            android:id="@+id/dialButton"
            android:layout_width="@dimen/dial_additional_button_height"
            android:layout_height="@dimen/dial_additional_button_height"
            android:src="@drawable/emergency_dial_action_icon"
            android:layout_centerHorizontal="true"
            android:contentDescription="@string/description_dial_button"
            app:oibGlassEnabled="true"
            style="@style/Widget.OvalImageButton.Dial"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/deleteButton"
            android:layout_width="@dimen/dial_additional_button_height"
            android:layout_height="@dimen/dial_additional_button_height"
            android:src="@drawable/ic_emergency_delete"
            android:contentDescription="@string/delete"/>
    </LinearLayout>
</LinearLayout>
