<?xml version="1.0" encoding="utf-8"?>
<com.android.phone.beidou.BDSatelliteLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/align_satellite_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/satellite_text_size"
        android:textColor="@color/satellite_guide_text_color"
        android:gravity="center_horizontal"
        android:id="@+id/guide_to_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lines="2"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/bd_signal"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/satellite_singal_img_margin_bottom"
        android:src="@drawable/bd_signal_2"/>
    <com.android.phone.beidou.SatelliteView
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/align_satellite_view"
        android:layout_width="@dimen/satellite_view_width"
        android:layout_height="@dimen/satellite_view_height"/>
    <com.android.phone.beidou.RotateView
        android:layout_gravity="center_horizontal"
        android:id="@+id/magnetic_calibrate"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="@dimen/satellite_service_provider_text_size_small"
        android:textColor="@color/satellite_guide_text_color"
        android:id="@+id/test_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</com.android.phone.beidou.BDSatelliteLayout>
