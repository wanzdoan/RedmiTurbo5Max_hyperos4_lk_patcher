<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/dialog_layout_padding_start_end"
    android:paddingEnd="@dimen/dialog_layout_padding_start_end">
    <TextView
        android:textColor="?android:attr/textColorPrimary"
        android:id="@android:id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/PromptText"/>
    <FrameLayout
        android:id="@+id/number_field"
        android:addStatesFromChildren="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/editphonenumber_field_start_end"
        android:paddingEnd="@dimen/editphonenumber_field_start_end">
        <EditText
            android:id="@android:id/edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ImageButton
            android:layout_gravity="end|center_vertical"
            android:id="@+id/select_contact"
            android:background="@drawable/ic_see_contacts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/selectContact"
            android:layout_marginEnd="@dimen/edittext_margin"/>
    </FrameLayout>
</LinearLayout>
