<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/top"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.android.phone.CustomView.EmergencyDialerKeyPadEditText
        android:textSize="@dimen/emergency_input_text_size"
        android:textColor="@color/emergency_title_text_color"
        android:textColorHint="@color/emergency_title_text_color"
        android:gravity="center"
        android:id="@+id/digits"
        android:background="@null"
        android:focusableInTouchMode="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/emergency_digits_height"
        android:layout_marginTop="@dimen/emergency_dialer_margin_top"
        android:hint="@string/emergency_enable_radio_dialog_title"
        android:maxLines="1"
        android:scrollHorizontally="true"
        android:freezesText="true"
        android:textAlignment="center"
        android:textFontWeight="380"/>
    <com.android.phone.EmergencyActionGroup
        android:id="@+id/emergency_action_group"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/digits"
        android:layout_marginHorizontal="36dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <Button
                android:textColor="@android:color/white"
                android:id="@+id/action1"
                android:background="@drawable/miui_btn_emergency"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <Button
                android:textColor="@android:color/white"
                android:id="@+id/action2"
                android:background="@drawable/miui_btn_emergency"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <Button
                android:textColor="@android:color/white"
                android:id="@+id/action3"
                android:background="@drawable/miui_btn_emergency"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/selected_container"
            android:focusable="true"
            android:visibility="invisible"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:background="#ffe32926"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                style="?android:attr/buttonStyle"/>
            <View
                android:id="@+id/ripple_view"
                android:background="#ffe32926"
                android:focusable="false"
                android:visibility="invisible"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                style="?android:attr/buttonStyle"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="#ffe32926"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                style="?android:attr/buttonStyle">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceButton"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:id="@+id/selected_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/emergency_information_confirm_hint"
                    android:maxLines="1"/>
                <TextView
                    android:textStyle="italic"
                    android:textColor="@android:color/white"
                    android:id="@+id/launch_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"/>
            </LinearLayout>
        </FrameLayout>
    </com.android.phone.EmergencyActionGroup>
    <Button
        android:textSize="@dimen/emergency_button_back_text_size"
        android:textColor="@color/emergency_button_text_color"
        android:gravity="center"
        android:id="@+id/mihealth"
        android:background="@null"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/emergency_dialer_margin_top"
        android:text="@string/emergency_medical_records"
        android:layout_below="@+id/digits"/>
    <RelativeLayout
        android:id="@+id/emergency_dialer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/emergency_dialpad"/>
        <include layout="@layout/dialpad_additional_buttons"/>
    </RelativeLayout>
</RelativeLayout>
