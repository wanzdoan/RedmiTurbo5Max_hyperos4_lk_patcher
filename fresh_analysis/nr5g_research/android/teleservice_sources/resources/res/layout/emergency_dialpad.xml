<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:slide="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/dtmf_twelve_key_dialer_view"
    android:paddingBottom="@dimen/dialer_dialpad_padding_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_above="@+id/dialpadAdditionalButtons"
    android:layoutDirection="ltr">
    <LinearLayout
        android:id="@+id/dialer_1"
        android:layout_marginBottom="@dimen/dial_panel_button_margin_bottom"
        style="@style/DialpadButtonLinearStyle">
        <com.android.phone.DialpadButton
            android:id="@+id/one"
            android:contentDescription="@string/description_image_button_one"
            slide:bottomImage="@drawable/ic_incall_voice_mail_image"
            slide:topImage="@drawable/ic_incall_one_image"
            style="@style/DialpadButtonStyle"/>
        <com.android.phone.DialpadButton
            android:id="@+id/two"
            android:contentDescription="@string/description_image_button_two"
            slide:bottomText="@string/dialpad_abc"
            slide:topImage="@drawable/ic_incall_two_image"
            style="@style/DialpadButtonStyle"/>
        <com.android.phone.DialpadButton
            android:id="@+id/three"
            android:contentDescription="@string/description_image_button_three"
            slide:bottomText="@string/dialpad_def"
            slide:topImage="@drawable/ic_incall_three_image"
            style="@style/DialpadButtonStyle"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/dialer_2"
        android:layout_marginBottom="@dimen/dial_panel_button_margin_bottom"
        style="@style/DialpadButtonLinearStyle">
        <com.android.phone.DialpadButton
            android:id="@+id/four"
            android:contentDescription="@string/description_image_button_four"
            slide:bottomText="@string/dialpad_ghi"
            slide:topImage="@drawable/ic_incall_four_image"
            style="@style/DialpadButtonStyle"/>
        <com.android.phone.DialpadButton
            android:id="@+id/five"
            android:contentDescription="@string/description_image_button_five"
            slide:bottomText="@string/dialpad_jkl"
            slide:topImage="@drawable/ic_incall_five_image"
            style="@style/DialpadButtonStyle"/>
        <com.android.phone.DialpadButton
            android:id="@+id/six"
            android:contentDescription="@string/description_image_button_six"
            slide:bottomText="@string/dialpad_mno"
            slide:topImage="@drawable/ic_incall_six_image"
            style="@style/DialpadButtonStyle"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/dialer_3"
        android:layout_marginBottom="@dimen/dial_panel_button_margin_bottom"
        style="@style/DialpadButtonLinearStyle">
        <com.android.phone.DialpadButton
            android:id="@+id/seven"
            android:contentDescription="@string/description_image_button_seven"
            slide:bottomText="@string/dialpad_pqrs"
            slide:topImage="@drawable/ic_incall_seven_image"
            style="@style/DialpadButtonStyle"/>
        <com.android.phone.DialpadButton
            android:id="@+id/eight"
            android:contentDescription="@string/description_image_button_eight"
            slide:bottomText="@string/dialpad_tuv"
            slide:topImage="@drawable/ic_incall_eight_image"
            style="@style/DialpadButtonStyle"/>
        <com.android.phone.DialpadButton
            android:id="@+id/nine"
            android:contentDescription="@string/description_image_button_nine"
            slide:bottomText="@string/dialpad_wxyz"
            slide:topImage="@drawable/ic_incall_nine_image"
            style="@style/DialpadButtonStyle"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/dialer_4"
        android:layout_marginBottom="@dimen/dial_panel_margin"
        style="@style/DialpadButtonLinearStyle">
        <com.android.phone.DialpadButton
            android:id="@+id/star"
            android:contentDescription="@string/description_image_button_star"
            slide:topText="@string/dialpad_star"
            style="@style/DialpadButtonStyle"/>
        <com.android.phone.DialpadButton
            android:id="@+id/zero"
            android:contentDescription="@string/description_image_button_zero"
            slide:bottomImage="@drawable/ic_incall_plus_image"
            slide:topImage="@drawable/ic_incall_zero_image"
            style="@style/DialpadButtonStyle"/>
        <com.android.phone.DialpadButton
            android:id="@+id/pound"
            android:contentDescription="@string/description_image_button_pound"
            slide:topText="@string/dialpad_pound"
            style="@style/DialpadButtonStyle"/>
    </LinearLayout>
</LinearLayout>
