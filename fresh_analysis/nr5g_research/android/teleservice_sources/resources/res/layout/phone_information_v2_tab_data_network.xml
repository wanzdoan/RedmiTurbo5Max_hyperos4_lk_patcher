<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/phone_button_0"
            android:background="?android:attr/selectableItemBackground"
            android:padding="12dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textStyle="bold"
                android:id="@+id/phone_button_0_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone0_title"/>
        </LinearLayout>
        <View
            android:background="?android:attr/listDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/phone_button_1"
            android:background="?android:attr/selectableItemBackground"
            android:padding="12dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textStyle="bold"
                android:id="@+id/phone_button_1_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone1_title"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:background="?android:attr/listDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout style="@style/RadioInfo_entry_layout">
                <TextView
                    android:text="@string/radio_info_current_network_label"
                    style="@style/info_label"/>
                <TextView
                    android:id="@+id/operator"
                    style="@style/info_value"/>
            </LinearLayout>
            <LinearLayout style="@style/RadioInfo_entry_layout">
                <TextView
                    android:text="@string/radio_info_roaming_label"
                    style="@style/info_label"/>
                <TextView
                    android:id="@+id/roaming"
                    style="@style/info_value"/>
            </LinearLayout>
            <LinearLayout style="@style/RadioInfo_entry_layout">
                <TextView
                    android:text="@string/radio_info_gprs_service_label"
                    style="@style/info_label"/>
                <TextView
                    android:id="@+id/gprs"
                    style="@style/info_value"/>
            </LinearLayout>
            <LinearLayout style="@style/RadioInfo_entry_layout">
                <TextView
                    android:text="@string/radio_info_data_network_type_label"
                    style="@style/info_label"/>
                <TextView
                    android:id="@+id/data_network"
                    style="@style/info_value"/>
            </LinearLayout>
            <LinearLayout style="@style/RadioInfo_entry_layout">
                <TextView
                    android:text="@string/radio_info_data_raw_registration_state_label"
                    style="@style/info_label"/>
                <TextView
                    android:id="@+id/data_raw_registration_state"
                    style="@style/info_value"/>
            </LinearLayout>
            <LinearLayout style="@style/RadioInfo_entry_layout">
                <TextView
                    android:text="@string/radio_info_override_network_type_label"
                    style="@style/info_label"/>
                <TextView
                    android:id="@+id/override_network"
                    style="@style/info_value"/>
            </LinearLayout>
            <LinearLayout style="@style/RadioInfo_entry_layout">
                <TextView
                    android:text="@string/radio_info_gsm_service_label"
                    style="@style/info_label"/>
                <TextView
                    android:id="@+id/gsm"
                    style="@style/info_value"/>
            </LinearLayout>
            <LinearLayout style="@style/RadioInfo_entry_layout">
                <TextView
                    android:text="@string/radio_info_voice_network_type_label"
                    style="@style/info_label"/>
                <TextView
                    android:id="@+id/voice_network"
                    style="@style/info_value"/>
            </LinearLayout>
            <LinearLayout style="@style/RadioInfo_entry_layout">
                <TextView
                    android:text="@string/radio_info_voice_raw_registration_state_label"
                    style="@style/info_label"/>
                <TextView
                    android:id="@+id/voice_raw_registration_state"
                    style="@style/info_value"/>
            </LinearLayout>
            <LinearLayout style="@style/RadioInfo_entry_layout">
                <TextView
                    android:text="@string/radio_info_signal_strength_label"
                    style="@style/info_label"/>
                <TextView
                    android:id="@+id/dbm"
                    style="@style/info_value"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                style="@style/RadioInfo_entry_layout">
                <TextView
                    android:text="@string/radio_info_dl_kbps"
                    style="@style/info_label"/>
                <TextView
                    android:id="@+id/dl_kbps"
                    style="@style/info_value"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                style="@style/RadioInfo_entry_layout">
                <TextView
                    android:text="@string/radio_info_ul_kbps"
                    style="@style/info_label"/>
                <TextView
                    android:id="@+id/ul_kbps"
                    style="@style/info_value"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/RadioInfo_entry_layout">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/radio_info_set_perferred_label"
                    style="@style/info_label"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/preferredNetworkTypeMultiSelect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <CheckBox
                        android:id="@+id/filter_all"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/radio_info_all_label"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <CheckBox
                            android:id="@+id/filter_nr"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/radio_info_nr_label"
                            android:layout_weight="1"/>
                        <CheckBox
                            android:id="@+id/filter_lte"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/radio_info_lte_label"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <CheckBox
                            android:id="@+id/filter_wcdma"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/radio_info_wcdma_label"
                            android:layout_weight="1"/>
                        <CheckBox
                            android:id="@+id/filter_gsm"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/radio_info_gsm_label"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <Button
                        android:layout_gravity="end"
                        android:id="@+id/preferredNetworkTypeApply"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/radio_info_apply_preferred_network_type"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout style="@style/RadioInfo_entry_layout">
                <TextView
                    android:id="@+id/signal_strength_label"
                    android:text="@string/radio_info_signal_strength_label"
                    style="@style/info_label"/>
                <Spinner
                    android:id="@+id/signalStrength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout style="@style/RadioInfo_entry_layout">
                <TextView
                    android:id="@+id/data_network_type_label"
                    android:text="@string/radio_info_data_network_type_label"
                    style="@style/info_label"/>
                <Spinner
                    android:id="@+id/dataNetworkType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                style="@style/RadioInfo_entry_layout">
                <TextView
                    android:id="@+id/nr_available_label"
                    android:text="@string/radio_info_nr_available"
                    style="@style/info_label"/>
                <TextView
                    android:id="@+id/nr_available"
                    style="@style/info_value"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                style="@style/RadioInfo_entry_layout">
                <TextView
                    android:id="@+id/nr_state_label"
                    android:text="@string/radio_info_nr_state"
                    style="@style/info_label"/>
                <TextView
                    android:id="@+id/nr_state"
                    style="@style/info_value"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                style="@style/RadioInfo_entry_layout">
                <TextView
                    android:id="@+id/nr_frequency_label"
                    android:text="@string/radio_info_nr_frequency"
                    style="@style/info_label"/>
                <TextView
                    android:id="@+id/nr_frequency"
                    style="@style/info_value"/>
            </LinearLayout>
            <Switch
                android:textSize="14sp"
                android:id="@+id/radio_power"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/radio_info_radio_power"/>
            <Switch
                android:textSize="14sp"
                android:id="@+id/simulate_out_of_service"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/simulate_out_of_service_label"/>
            <Switch
                android:textSize="14sp"
                android:id="@+id/volte_provisioned_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/volte_provisioned_switch_string"/>
            <Switch
                android:textSize="14sp"
                android:id="@+id/vt_provisioned_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/vt_provisioned_switch_string"/>
            <Switch
                android:textSize="14sp"
                android:id="@+id/wfc_provisioned_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/wfc_provisioned_switch_string"/>
            <Switch
                android:textSize="14sp"
                android:id="@+id/eab_provisioned_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/eab_provisioned_switch_string"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/radio_info_cell_info_refresh_rate"
                style="@style/info_label"/>
            <Spinner
                android:id="@+id/cell_info_rate_select"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout style="@style/RadioInfo_entry_layout">
                <TextView
                    android:text="@string/radio_info_cellinfo_label"
                    style="@style/info_label"/>
            </LinearLayout>
            <LinearLayout style="@style/RadioInfo_entry_layout">
                <TextView
                    android:textSize="12sp"
                    android:id="@+id/cellinfo"
                    android:minHeight="300dp"
                    style="@style/info_value"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
