<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/mi_activate_dialog_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_mi_sim_activate"/>
    <TextView
        android:textSize="@dimen/mi_sim_activate_text_size"
        android:textStyle="bold"
        android:textColor="@color/mi_activate_dialog_title_color"
        android:gravity="center"
        android:id="@+id/mi_activate_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mi_sim_activate_dialog_title_margin_top"
        android:text="@string/mi_mobile_sim_activate_title"/>
</LinearLayout>
