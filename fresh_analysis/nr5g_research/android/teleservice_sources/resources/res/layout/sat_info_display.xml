<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@android:style/Widget.DeviceDefault.Light.ScrollView">
    <LinearLayout
        android:focusableInTouchMode="true"
        android:descendantFocusability="beforeDescendants"
        style="@style/info_layout">
        <RelativeLayout
            android:id="@+id/setting_modem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:id="@+id/modem_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Switch modem"/>
            <Switch
                android:id="@+id/setting_modem_sw"
                android:padding="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                android:textOn="on"
                android:textOff="off"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:switchMinWidth="60dp"
                android:showText="true"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="16dp"
                android:layout_below="@+id/modem_switch"/>
        </RelativeLayout>
        <View
            android:background="#000000"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout style="@style/sat_info_entry_layout">
            <TextView
                android:textStyle="bold"
                android:text="@string/sat_call_status"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/valueCallStatus"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/sat_info_entry_layout">
            <TextView
                android:textStyle="bold"
                android:text="@string/sat_reg"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/valueRegState"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/sat_info_entry_layout">
            <TextView
                android:textStyle="bold"
                android:text="@string/sat_rssi"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/valueRssi"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/sat_info_entry_layout">
            <TextView
                android:text="@string/sat_Snr"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/valueSnr"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/sat_info_entry_layout">
            <TextView
                android:textStyle="bold"
                android:text="@string/sat_sub_id"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/valueSubId"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/sat_info_entry_layout">
            <TextView
                android:text="@string/sat_TXPWR"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/valueTXPWR"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/entry_layout">
            <TextView
                android:textStyle="bold"
                android:text="@string/sat_location"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/valueSatLocation"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/sat_info_entry_layout">
            <TextView
                android:textStyle="bold"
                android:text="@string/sat_PhoneAngle"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/valuePhoneAngle"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/entry_layout">
            <TextView
                android:textStyle="bold"
                android:text="@string/sat_version"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/valueVersion"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/sat_info_entry_layout">
            <TextView
                android:textStyle="bold"
                android:text="@string/sat_plmn"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/valuePLMN"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/sat_info_entry_layout">
            <TextView
                android:textStyle="bold"
                android:text="@string/sat_id"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/valueSatId"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/sat_info_entry_layout">
            <TextView
                android:text="@string/sat_cpst_info"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/valueCPST"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/sat_info_entry_layout">
            <TextView
                android:text="@string/sat_USIMType"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/valueUSIMType"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/sat_info_entry_layout">
            <TextView
                android:text="@string/sat_USIMPre"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/valueUSIMPre"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/sat_info_entry_layout">
            <TextView
                android:text="@string/sat_USIMStart"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/valueUSIMStartUp"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/sat_info_entry_layout">
            <TextView
                android:text="@string/sat_ChQual"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/valueChQual"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/sat_info_entry_layout">
            <TextView
                android:text="@string/sat_CBCHInd"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/valueCBCHInd"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/sat_info_entry_layout">
            <TextView
                android:text="@string/sat_Pwr"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/valuePwr"
                style="@style/info_value"/>
        </LinearLayout>
        <View
            android:background="#000000"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sat_Log_Level"
            style="@style/info_label"/>
        <Spinner
            android:id="@+id/valueLogLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:background="#000000"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sat_dual_beam_switching_settings"
            style="@style/info_label"/>
        <Spinner
            android:id="@+id/sat_dual_beam_switching_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <Switch
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary"
            android:id="@+id/lpm_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sat_lpm_switch"/>
        <LinearLayout style="@style/sat_info_entry_layout">
            <TextView
                android:text="@string/sat_lpm_state"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/current_sat_lpm_state"
                style="@style/info_value"/>
        </LinearLayout>
        <Button
            android:textSize="14sp"
            android:id="@+id/current_ant_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/current_ant_info"/>
        <LinearLayout style="@style/sat_info_entry_layout">
            <TextView
                android:text="@string/sat_tx_ant_info"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/current_tx_ant_info"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/sat_info_entry_layout">
            <TextView
                android:text="@string/sat_rx_ant_info"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/current_rx_ant_info"
                style="@style/info_value"/>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sat_switch_tx_ant"
            style="@style/info_label"/>
        <Spinner
            android:id="@+id/tx_ant_values"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sat_switch_rx_ant"
            style="@style/info_label"/>
        <Spinner
            android:id="@+id/rx_ant_values"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout style="@style/sat_info_entry_layout">
            <TextView
                android:text="@string/sat_ant1_rssi"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/ant1_rssi"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/sat_info_entry_layout">
            <TextView
                android:text="@string/sat_ant1_snr"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/ant1_snr"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/sat_info_entry_layout">
            <TextView
                android:text="@string/sat_ant2_rssi"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/ant2_rssi"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/sat_info_entry_layout">
            <TextView
                android:text="@string/sat_ant2_snr"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/ant2_snr"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/sat_info_entry_layout">
            <TextView
                android:text="@string/sat_ant1_ant2_combine_rssi"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/ant1_ant2_combine_rssi"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/sat_info_entry_layout">
            <TextView
                android:text="@string/sat_ant1_ant2_combine_snr"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/ant1_ant2_combine_snr"
                style="@style/info_value"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
