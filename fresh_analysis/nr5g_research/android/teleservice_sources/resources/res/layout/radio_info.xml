            style="@style/RadioInfo_entry_layout">
            <TextView
                android:id="@+id/euicc_info_label"
                android:text="@string/radio_info_euicc_info"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/euicc_info"
                style="@style/info_value"/>
        </LinearLayout>
        <View
            android:background="?android:attr/listDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/radio_info_set_perferred_label"
            style="@style/info_label"/>
        <Spinner
            android:id="@+id/preferredNetworkType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout style="@style/RadioInfo_entry_layout">
            <TextView
                android:id="@+id/signal_strength_label"
                android:text="@string/radio_info_signal_strength_label"
                style="@style/info_label"/>
            <Spinner
                android:id="@+id/signalStrength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout style="@style/RadioInfo_entry_layout">
            <TextView
                android:id="@+id/data_network_type_label"
                android:text="@string/radio_info_data_network_type_label"
                style="@style/info_label"/>
            <Spinner
                android:id="@+id/dataNetworkType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <View
            android:background="?android:attr/listDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <Switch
            android:textSize="14sp"
            android:id="@+id/radio_power"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/radio_info_radio_power"/>
        <Switch
            android:textSize="14sp"
            android:id="@+id/simulate_out_of_service"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/simulate_out_of_service_string"/>
        <Switch
            android:textSize="14sp"
            android:id="@+id/enforce_satellite_channel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/enforce_satellite_channel_string"/>
        <RadioGroup
            android:orientation="horizontal"
            android:id="@+id/force_camp_satellite_selection_radio_group"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <RadioButton
                android:id="@+id/starlink_band"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/starlink_satellite_band_string"
                android:layout_marginEnd="4dp"/>
            <RadioButton
                android:id="@+id/ast_band"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ast_satellite_band_string"
                android:layout_marginEnd="4dp"/>
            <RadioButton
                android:id="@+id/manual_override_band"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manual_override_satellite_band_string"/>
        </RadioGroup>
        <LinearLayout style="@style/RadioInfo_entry_layout">
            <TextView
                android:id="@+id/manual_band_selector_label"
                android:text="@string/satellite_manual_band_label"
                style="@style/info_label"/>
            <Spinner
                android:id="@+id/manualBandSelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/satellite_channel_label"
                android:text="@string/satellite_channel_label_text"
                style="@style/info_label"/>
            <EditText
                android:id="@+id/satellite_channel_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/satellite_channel_hint_text"
                android:inputType="number"
                android:imeOptions="actionDone"
                style="@style/form_value"/>
        </LinearLayout>
        <Button
            android:textSize="14sp"
            android:id="@+id/force_camp_satellite_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/force_camp_satellite_button_string"
            android:textAllCaps="false"/>
        <Switch
            android:textSize="14sp"
            android:id="@+id/mock_carrier_roaming_satellite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/mock_carrier_roaming_satellite_string"/>
        <Switch
            android:textSize="14sp"
            android:id="@+id/satellite_data_controller_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/choose_satellite_data_mode"/>
        <RadioGroup
            android:orientation="horizontal"
            android:id="@+id/satellite_data_controller"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <RadioButton
                android:id="@+id/satellite_data_restricted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp"
                android:text="@string/satellite_data_restricted_string"/>
            <RadioButton
                android:id="@+id/satellite_data_constrained"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp"
                android:text="@string/satellite_data_constrained_string"/>
            <RadioButton
                android:id="@+id/satellite_data_unConstrained"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/satellite_data_unConstrained_string"/>
        </RadioGroup>
        <Button
            android:textSize="14sp"
            android:id="@+id/esos_questionnaire"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/esos_satellite_string"
            android:textAllCaps="false"/>
        <Button
            android:textSize="14sp"
            android:id="@+id/satellite_enable_non_emergency_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/satellite_enable_non_emergency_mode_string"
            android:textAllCaps="false"/>
        <Button
            android:textSize="14sp"
            android:id="@+id/demo_esos_questionnaire"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/demo_esos_satellite_string"
            android:textAllCaps="false"/>
        <Button
            android:textSize="14sp"
            android:id="@+id/satellite_config_viewer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/satellite_config_viewer"
            android:textAllCaps="false"/>
        <Switch
            android:textSize="14sp"
            android:id="@+id/volte_provisioned_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/volte_provisioned_switch_string"/>
        <Switch
            android:textSize="14sp"
            android:id="@+id/vt_provisioned_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/vt_provisioned_switch_string"/>
        <Switch
            android:textSize="14sp"
            android:id="@+id/wfc_provisioned_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/wfc_provisioned_switch_string"/>
        <Switch
            android:textSize="14sp"
            android:id="@+id/eab_provisioned_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/eab_provisioned_switch_string"/>
        <View
            android:background="?android:attr/listDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <Switch
            android:textSize="14sp"
            android:id="@+id/cbrs_data_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/cbrs_data_switch_string"/>
        <Switch
            android:textSize="14sp"
            android:id="@+id/dsds_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dsds_switch_string"/>
        <Switch
            android:enabled="false"
            android:textSize="14sp"
            android:id="@+id/removable_esim_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/removable_esim_string"/>
        <View
            android:background="?android:attr/listDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <Button
            android:textSize="14sp"
            android:id="@+id/ping_test"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ping_test_label"/>
        <LinearLayout style="@style/RadioInfo_entry_layout">
            <TextView
                android:text="@string/radio_info_ping_hostname_v4"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/pingHostnameV4"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/RadioInfo_entry_layout">
            <TextView
                android:text="@string/radio_info_ping_hostname_v6"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/pingHostnameV6"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/RadioInfo_entry_layout">
            <TextView
                android:text="@string/radio_info_http_client_test"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/httpClientTest"
                style="@style/info_value"/>
        </LinearLayout>
        <View
            android:background="?android:attr/listDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout style="@style/RadioInfo_entry_layout">
            <TextView
                android:text="@string/radio_info_ppp_sent_label"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/sent"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/RadioInfo_entry_layout">
            <TextView
                android:text="@string/radio_info_ppp_received_label"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/received"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/RadioInfo_entry_layout">
            <TextView
                android:text="@string/radio_info_ppp_resets_label"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/sentSinceReceived"
                style="@style/info_value"/>
        </LinearLayout>
        <View
            android:background="?android:attr/listDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout style="@style/RadioInfo_entry_layout">
            <TextView
                android:text="@string/radio_info_call_status_label"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/call"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/RadioInfo_entry_layout">
            <TextView
                android:text="@string/radio_info_message_waiting_label"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/mwi"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/RadioInfo_entry_layout">
            <TextView
                android:text="@string/radio_info_call_redirect_label"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/cfi"
                style="@style/info_value"/>
        </LinearLayout>
        <View
            android:background="?android:attr/listDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/radio_info_cell_info_refresh_rate"
            style="@style/info_label"/>
        <Spinner
            android:id="@+id/cell_info_rate_select"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout style="@style/RadioInfo_entry_layout">
            <TextView
                android:text="@string/radio_info_phy_chan_config"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/phy_chan_config"
                style="@style/info_value"/>
        </LinearLayout>
        <LinearLayout style="@style/RadioInfo_entry_layout">
            <TextView
                android:text="@string/radio_info_cellinfo_label"
                style="@style/info_label"/>
        </LinearLayout>
        <LinearLayout style="@style/RadioInfo_entry_layout">
            <TextView
                android:textSize="12sp"
                android:id="@+id/cellinfo"
                android:minHeight="300dp"
                style="@style/info_value"/>
        </LinearLayout>
        <View
            android:background="?android:attr/listDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:orientation="horizontal"
            style="@style/RadioInfo_entry_layout">
            <Button
                android:textSize="14sp"
                android:id="@+id/carrier_provisioning"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/carrier_provisioning"
                android:layout_weight="1"/>
            <Button
                android:textSize="14sp"
                android:id="@+id/trigger_carrier_provisioning"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/trigger_carrier_provisioning"
                android:layout_weight="1"/>
            <Button
                android:textSize="14sp"
                android:id="@+id/oem_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/oem_radio_info_label"
                android:layout_weight="1"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/smsc_label"
                android:text="@string/radio_info_smsc_label"
                android:layout_alignBaseline="@+id/update_smsc"
                style="@style/info_label"/>
            <Button
                android:textSize="14sp"
                android:id="@+id/refresh_smsc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/radio_info_smsc_refresh_label"
                android:layout_alignParentEnd="true"/>
            <Button
                android:textSize="14sp"
                android:id="@+id/update_smsc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/radio_info_smsc_update_label"
                android:layout_alignBaseline="@+id/refresh_smsc"
                android:layout_toStartOf="@+id/refresh_smsc"/>
            <EditText
                android:id="@+id/smsc"
                android:layout_alignBaseline="@+id/refresh_smsc"
                android:layout_toStartOf="@+id/update_smsc"
                android:layout_toEndOf="@+id/smsc_label"
                style="@style/form_value"/>
        </RelativeLayout>
    </LinearLayout>
</ScrollView>
