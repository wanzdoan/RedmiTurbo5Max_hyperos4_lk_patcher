<?xml version="1.0" encoding="utf-8"?>
<miuix.springback.view.SpringBackLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:scrollableView="@+id/scrollView">
    <miuix.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/dialog_layout_padding_start_end"
                android:paddingEnd="@dimen/dialog_layout_padding_start_end">
                <EditText
                    android:id="@+id/fdn_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/edittext_spacing_margin_top"
                    android:hint="@string/sim_contact_name"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:capitalize="words"
                    android:autoText="false"
                    android:inputType="textPersonName"
                    android:textDirection="ltr"
                    android:textAlignment="viewStart"
                    style="@style/Widget.EditText.Dialog"/>
                <EditText
                    android:id="@+id/fdn_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/edittext_spacing_margin_top"
                    android:hint="@string/sim_contact_number"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:capitalize="none"
                    android:autoText="false"
                    android:layout_below="@+id/fdn_name"
                    android:inputType="phone"
                    android:textDirection="ltr"
                    android:textAlignment="viewStart"
                    style="@style/Widget.EditText.Dialog"/>
                <EditText
                    android:id="@+id/fdn_pin2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/edittext_spacing_margin_top"
                    android:layout_marginBottom="5dp"
                    android:hint="@string/enter_pin2_text"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:layout_below="@+id/fdn_number"
                    android:inputType="textPassword"
                    android:textDirection="ltr"
                    android:textAlignment="viewStart"
                    style="@style/Widget.EditText.Dialog"/>
                <Button
                    android:id="@+id/fdn_delete"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/edittext_spacing_margin_top"
                    android:text="@string/delete_fdn_contact"
                    android:layout_below="@+id/fdn_pin2"
                    style="@style/Widget.Button.Warning"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/edittext_spacing_margin_top"
                android:layout_marginStart="@dimen/dialog_layout_padding_start_end"
                android:layout_marginEnd="@dimen/dialog_layout_padding_start_end">
                <Button
                    android:id="@+id/fdn_cancel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:text="@android:string/cancel"
                    android:layout_weight="1"/>
                <Button
                    android:id="@+id/fdn_ok"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:text="@android:string/ok"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
    </miuix.core.widget.NestedScrollView>
</miuix.springback.view.SpringBackLayout>
