<?xml version="1.0" encoding="utf-8"?>
<miuix.appcompat.internal.app.widget.SearchActionModeView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_panel"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="@dimen/miuix_appcompat_search_view_default_height"
    android:paddingStart="@dimen/miuix_appcompat_search_mode_bg_padding"
    style="@style/Widget.SearchActionMode.Input">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/miuix_appcompat_search_mode_bg_size">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/search_text_cancel"
            android:contentDescription="@string/miuix_appcompat_cancel_description"
            android:layout_marginStart="@dimen/miuix_appcompat_search_action_mode_cancel_text_margin_start"
            android:layout_marginEnd="@dimen/miuix_appcompat_search_action_mode_cancel_text_margin_end"
            android:layout_alignParentEnd="true"
            app:srcCompat="?attr/miuixAppcompatSearchViewBackIconEnd"
            style="?attr/miuixAppcompatSearchViewIconStyle"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/search_container"
            android:background="?attr/miuixAppcompatSearchModeEditTextBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="?attr/miuixAppcompatEditTextSearchIcon"
                android:scaleType="centerInside"
                android:paddingStart="@dimen/miuix_appcompat_edit_text_search_bg_icon_padding_start"
                android:paddingEnd="@dimen/miuix_appcompat_edit_text_search_bg_icon_padding_end"/>
            <miuix.androidbasewidget.widget.ClearableEditText
                android:textSize="@dimen/miuix_appcompat_search_edit_text_size"
                android:textColorHint="?attr/searchEditTextHintColor"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@android:id/input"
                android:background="@null"
                android:scrollbars="none"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:textDirection="locale"
                android:paddingStart="0dp"
                app:drawableEndCompat="?attr/clearEditTextIcon"/>
        </LinearLayout>
    </RelativeLayout>
</miuix.appcompat.internal.app.widget.SearchActionModeView>
