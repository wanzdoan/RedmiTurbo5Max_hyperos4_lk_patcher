<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sim_info"
        android:background="@drawable/sim_bg_top"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no">
            <ImageView
                android:id="@+id/icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sim_info_margin"
                android:layout_marginStart="@dimen/sim_info_margin"
                android:layout_marginEnd="@dimen/sim_info_margin"/>
            <ImageView
                android:id="@+id/eicon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sim_info_margin"
                android:src="@drawable/ic_esim"
                android:layout_alignParentRight="true"
                android:layout_marginStart="@dimen/sim_info_margin"
                android:layout_marginEnd="@dimen/sim_info_margin"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/sim_info_title_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.android.phone.settings.sim.MarqueeTextView
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sim_info_title_margin_top"
                android:layout_alignParentTop="true"
                android:layout_marginStart="@dimen/sim_info_margin"
                android:layout_marginEnd="@dimen/sim_info_margin"
                style="@style/sim_title"/>
            <TextView
                android:textSize="@dimen/sim_info_display_number_text_size"
                android:textColor="@color/sim_number_color"
                android:id="@+id/summary"
                android:scrollbars="none"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/sim_info_summary_margin"
                android:singleLine="true"
                android:layout_alignParentTop="true"
                android:textDirection="ltr"
                android:layout_marginStart="@dimen/sim_info_margin"
                android:layout_marginEnd="@dimen/sim_info_margin"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="@drawable/sim_divider_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/sim_divider_height"/>
    <RelativeLayout
        android:id="@+id/extra_info"
        android:background="@drawable/sim_bg_bottom"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/sim_info_extra_height">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignWithParentIfMissing="true"
            android:paddingStart="@dimen/sim_info_horizontal_padding"
            android:layout_toStartOf="@+id/extra_summary_layout"
            android:layout_alignParentStart="true">
            <TextView
                android:textSize="@dimen/sim_info_extra_title_text_size"
                android:ellipsize="end"
                android:id="@+id/extra_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxEms="6"
                android:singleLine="true"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <ImageView
                android:id="@+id/red_dot"
                android:background="@drawable/red_dot"
                android:visibility="gone"
                android:layout_width="@dimen/sim_red_dot_size"
                android:layout_height="@dimen/sim_red_dot_size"
                android:layout_alignTop="@+id/extra_title"
                android:layout_marginStart="@dimen/sim_red_dot_margin"
                android:layout_toEndOf="@+id/extra_title"/>
        </RelativeLayout>
        <LinearLayout
            android:id="@+id/extra_summary_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:paddingEnd="@dimen/sim_info_horizontal_padding"
            android:layout_alignParentEnd="true">
            <TextView
                android:textSize="@dimen/sim_value_text_size"
                android:id="@+id/extra_summary_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:fontFamily="mitype-bold"/>
            <TextView
                android:textSize="@dimen/sim_unit_text_size"
                android:id="@+id/extra_summary_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
