<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center"
            android:id="@+id/modem_set_menu_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/modem_set_title"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center"
            android:id="@+id/lte_band_sel_set_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lte_band_sel_setting"
            android:layout_weight="1"/>
        <Spinner
            android:gravity="center"
            android:id="@+id/lte_band_sel_set_status_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:gravity="center"
            android:id="@+id/lte_band_set_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/lte_band_set_status"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp">
        <TextView
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/frequecy_num"
            android:layout_weight="1"/>
        <EditText
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:id="@+id/set_frequency_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="300"
            android:layout_weight="1"
            android:inputType="number"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp">
        <TextView
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/pci_num"
            android:layout_weight="1"/>
        <EditText
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:id="@+id/set_pci_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="1"
            android:layout_weight="1"
            android:inputType="number"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:gravity="center"
            android:id="@+id/lte_freq_set_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lte_freq_set_button"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center"
            android:id="@+id/eps_only_set_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/eps_only_set_title"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:gravity="center"
            android:id="@+id/eps_only_set_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/eps_only_set_button"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center"
            android:id="@+id/clear_all_set_text"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/clear_all_set_title"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:gravity="center"
            android:id="@+id/clear_all_set_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/clear_all_set_button"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
