<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/select_sim_option_height">
    <LinearLayout
        android:id="@+id/CmServiceLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="@style/Miuix.AppCompat.TextAppearance.AlertDialogListItem.SingleChoice"
            android:id="@+id/txt_displayname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/select_sim_margin_start_end"
            android:layout_marginEnd="1dp"
            app:layout_constrainedWidth="true"
            app:layout_goneMarginEnd="@dimen/select_sim_margin_start_end"/>
        <ImageView
            android:id="@+id/img_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="@+id/txt_description"
            app:layout_constraintTop_toTopOf="@+id/txt_displayname"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/select_sim_text_size"
        android:id="@+id/txt_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textDirection="ltr"
        android:layout_marginStart="@dimen/select_sim_margin_start_end"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/txt_extra"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/CmServiceLayout"
        app:layout_constraintTop_toBottomOf="@+id/CmServiceLayout"/>
    <TextView
        android:textAppearance="@style/Miuix.AppCompat.TextAppearance.AlertDialogListItem.SingleChoice"
        android:id="@+id/txt_extra"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/can_not_use"
        android:layout_marginStart="@dimen/select_sim_margin_start_end"
        android:layout_marginEnd="@dimen/select_sim_margin_start_end"
        app:layout_constraintBottom_toBottomOf="@+id/txt_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/CmServiceLayout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
