<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/telocation_edit_custom_location_title"/>
            <EditText
                android:id="@+id/custom_number"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/telocation_custom_number_hint"
                android:singleLine="true"
                android:phoneNumber="true"/>
            <EditText
                android:id="@+id/custom_location"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/telocation_custom_name_hint"
                android:singleLine="true"/>
            <TextView
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="10dp"
                android:text="@string/telocation_number_type"/>
            <RadioGroup
                android:orientation="vertical"
                android:id="@+id/type_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/type_tel"
                    android:background="@drawable/miuix_preference_item_background_light"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/telocation_number_type_tel"/>
                <RadioButton
                    android:id="@+id/type_mob"
                    android:background="@drawable/miuix_preference_item_background_light"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/telocation_number_type_mob"/>
                <RadioButton
                    android:id="@+id/type_jituan"
                    android:background="@drawable/miuix_preference_item_background_light"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/telocation_number_type_jituan"/>
            </RadioGroup>
            <Button
                android:id="@+id/btn_delete"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:text="@string/remove"
                style="@style/Widget.Button.Warning"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp">
        <Button
            android:id="@+id/btn_discard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@android:string/cancel"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/btn_done"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@android:string/ok"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
