<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/DialogLayout">
    <TextView
        android:id="@+id/change_password_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        style="@style/PromptText"/>
    <EditText
        android:id="@+id/call_carring_old_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/change_password_prompt"
        android:inputType="textPassword"
        style="@style/Widget.EditText.Dialog"/>
    <EditText
        android:id="@+id/call_carring_new_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/edittext_spacing_margin_top"
        android:layout_below="@+id/call_carring_old_password"
        android:inputType="textPassword"
        style="@style/Widget.EditText.Dialog"/>
    <EditText
        android:id="@+id/call_carring_new_password_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/edittext_spacing_margin_top"
        android:layout_below="@+id/call_carring_new_password"
        android:inputType="textPassword"
        style="@style/Widget.EditText.Dialog"/>
</RelativeLayout>
