<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:forceDarkAllowed="false">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <EditText
                android:textSize="@dimen/sim_card_number_text_size"
                android:textColor="@color/sim_card_number_text_color"
                android:gravity="center"
                android:id="@+id/sim_number_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:drawableLeft="@drawable/ic_sim_1_big"
                android:inputType="phone"
                android:layoutDirection="rtl"
                android:layout_marginStart="@dimen/sim_card_number_margin_start"
                android:layout_marginEnd="@dimen/sim_card_number_margin_end"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/sim_card_margin_top">
            <EditText
                android:textSize="@dimen/sim_card_number_text_size"
                android:textColor="@color/sim_card_number_text_color"
                android:gravity="center"
                android:id="@+id/sim_number_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:drawableLeft="@drawable/ic_sim_2_big"
                android:inputType="phone"
                android:layoutDirection="rtl"
                android:layout_marginStart="@dimen/sim_card_number_margin_start"
                android:layout_marginEnd="@dimen/sim_card_number_margin_end"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
