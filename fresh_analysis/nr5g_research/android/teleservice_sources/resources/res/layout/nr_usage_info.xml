<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:focusableInTouchMode="true"
        android:descendantFocusability="beforeDescendants"
        style="@style/info_layout">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nr_usaged_module"
            style="@style/device_info_dialog_label"/>
        <TextView
            android:id="@+id/nr_usaged_module"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_unavailable"
            style="@style/device_info_dialog_value"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nr_usaged_operator"
            style="@style/device_info_dialog_label"/>
        <TextView
            android:id="@+id/nr_usaged_operator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_unavailable"
            style="@style/device_info_dialog_value"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nr_usaged_first_used_time"
            style="@style/device_info_dialog_label"/>
        <TextView
            android:id="@+id/nr_usaged_first_used_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_unavailable"
            style="@style/device_info_dialog_value"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nr_usaged_used_time"
            style="@style/device_info_dialog_label"/>
        <TextView
            android:id="@+id/nr_usaged_used_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_unavailable"
            style="@style/device_info_dialog_value"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nr_usaged_network_usaged"
            style="@style/device_info_dialog_label"/>
        <TextView
            android:id="@+id/nr_usaged_network_usaged"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_unavailable"
            style="@style/device_info_dialog_value"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nr_usaged_network_rate"
            style="@style/device_info_dialog_label"/>
        <TextView
            android:id="@+id/nr_usaged_network_rate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_unavailable"
            style="@style/device_info_dialog_value"/>
    </LinearLayout>
</ScrollView>
