<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/phone_button_0"
            android:background="?android:attr/selectableItemBackground"
            android:padding="12dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textStyle="bold"
                android:id="@+id/phone_button_0_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone0_title"/>
        </LinearLayout>
        <View
            android:background="?android:attr/listDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/phone_button_1"
            android:background="?android:attr/selectableItemBackground"
            android:padding="12dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textStyle="bold"
                android:id="@+id/phone_button_1_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone1_title"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:background="?android:attr/listDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout style="@style/RadioInfo_entry_layout">
                <TextView
                    android:text="@string/radio_info_imei_label"
                    style="@style/info_label"/>
                <TextView
                    android:id="@+id/imei"
                    style="@style/info_value"/>
            </LinearLayout>
            <LinearLayout style="@style/RadioInfo_entry_layout">
                <TextView
                    android:text="@string/radio_info_phone_number_label"
                    style="@style/info_label"/>
                <TextView
                    android:id="@+id/number"
                    style="@style/info_value"/>
            </LinearLayout>
            <LinearLayout style="@style/RadioInfo_entry_layout">
                <TextView
                    android:text="@string/radio_info_subid"
                    style="@style/info_label"/>
                <TextView
                    android:id="@+id/subid"
                    style="@style/info_value"/>
            </LinearLayout>
            <LinearLayout style="@style/RadioInfo_entry_layout">
                <TextView
                    android:text="@string/radio_info_dds"
                    style="@style/info_label"/>
                <TextView
                    android:id="@+id/dds"
                    style="@style/info_value"/>
            </LinearLayout>
            <LinearLayout style="@style/RadioInfo_entry_layout">
                <TextView
                    android:text="@string/radio_info_imsi_label"
                    style="@style/info_label"/>
                <TextView
                    android:id="@+id/imsi"
                    style="@style/info_value"/>
            </LinearLayout>
            <LinearLayout style="@style/RadioInfo_entry_layout">
                <TextView
                    android:text="@string/radio_info_gid1_label"
                    style="@style/info_label"/>
                <TextView
                    android:id="@+id/gid1"
                    style="@style/info_value"/>
            </LinearLayout>
            <LinearLayout style="@style/RadioInfo_entry_layout">
                <TextView
                    android:text="@string/radio_info_carrier_id_label"
                    style="@style/info_label"/>
                <TextView
                    android:id="@+id/carrier_id"
                    style="@style/info_value"/>
            </LinearLayout>
            <Switch
                android:enabled="false"
                android:textSize="14sp"
                android:id="@+id/removable_esim_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/removable_esim_string"/>
            <Switch
                android:textSize="14sp"
                android:id="@+id/dsds_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/dsds_switch_string"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
