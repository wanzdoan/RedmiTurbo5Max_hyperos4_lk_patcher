<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@android:id/button1"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/miuix_appcompat_action_mode_title_button_width"
        android:layout_height="@dimen/miuix_appcompat_action_mode_title_button_height"
        android:scaleType="centerInside"
        style="?attr/actionModeCancelButtonStyle"/>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:importantForAccessibility="no">
        <miuix.appcompat.internal.view.CollapseTitleTextView
            android:textAppearance="@style/Miuix.AppCompat.TextAppearance.Widget.ActionMode.Title"
            android:gravity="center"
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?attr/collapseTitleTheme"/>
    </LinearLayout>
    <ImageView
        android:id="@android:id/button2"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/miuix_appcompat_action_mode_title_button_width"
        android:layout_height="@dimen/miuix_appcompat_action_mode_title_button_height"
        android:scaleType="centerInside"
        style="?attr/actionModeSelectButtonStyle"/>
</LinearLayout>
