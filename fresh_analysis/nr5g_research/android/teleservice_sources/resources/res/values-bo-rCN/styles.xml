<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Button" parent="@android:style/Widget.Button">
        <item name="android:textAppearance">@style/Miuix.AppCompat.TextAppearance.Widget.Button</item>
        <item name="android:textSize">@dimen/miuix_appcompat_button_text_size</item>
        <item name="android:textColor">?attr/textColorButton</item>
        <item name="android:ellipsize">3</item>
        <item name="android:background">?attr/buttonBackground</item>
        <item name="android:maxWidth">@dimen/miuix_appcompat_button_max_width</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:elegantTextHeight">true</item>
        <item name="android:fallbackLineSpacing">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="isLightTheme">true</item>
    </style>
    <style name="Widget.StateEditText" parent="@style/Widget.EditText">
        <item name="android:textColor">?android:attr/editTextColor</item>
        <item name="android:textColorHint">?attr/editTextColorHint</item>
        <item name="android:gravity">0x800015</item>
        <item name="miuixAppcompatLabelLineSpacingMulti">1.25</item>
        <item name="miuixAppcompatWidgetPadding">@dimen/miuix_appcompat_state_edit_widget_padding</item>
    </style>
    <style name="Widget.TextProgressBar.Text" parent="">
        <item name="android:textSize">@dimen/miuix_font_size_headline2</item>
        <item name="android:textColor">?attr/colorOnSurfaceSecondary</item>
        <item name="android:scrollbars">0x0</item>
        <item name="android:fontFamily">@string/miuix_font_weight_headline2</item>
        <item name="android:textAlignment">4</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fallbackLineSpacing">true</item>
    </style>
</resources>
